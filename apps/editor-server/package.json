{
  "name": "@ancadeba/editor-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@ancadeba/source src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ancadeba/schemas": "workspace:*",
    "@ancadeba/utilities": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
