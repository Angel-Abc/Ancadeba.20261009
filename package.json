{
  "name": "ancadeba",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.5.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:engine": "pnpm --filter @ancadeba/engine dev",
    "dev:editor-ui": "pnpm --filter @ancadeba/editor-ui dev",
    "dev:editor-server": "pnpm --filter @ancadeba/editor-server dev",
    "lint": "eslint . && pnpm -r typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@ancadeba/schemas": "workspace:*",
    "@ancadeba/utilities": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
