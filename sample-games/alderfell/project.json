    "dialogues": [
      {
        "id": "road-warden",
        "name": "The road warden",
        "startNodeId": "welcome",
        "nodes": [
          {
            "id": "welcome",
            "speaker": "",
            "text": "The forest remembers every traveller. What brings you to Alderfell?",
            "choices": [
              {
                "id": "ask-road",
                "text": "Tell me about the road.",
                "nextNodeId": "road",
                "conditions": [],
                "effects": []
              },
              {
                "id": "ask-work",
                "text": "Can I help?",
                "nextNodeId": "offer",
                "conditions": [
                  {
                    "flag": "meet-keeper",
                    "equals": false
                  }
                ],
                "effects": []
              },
              {
                "id": "share-news",
                "text": "I have spoken with the grove keeper.",
                "nextNodeId": "thanks",
                "conditions": [
                  {
                    "flag": "grove-blessing",
                    "equals": true
                  }
                ],
                "effects": []
              },
              {
                "id": "leave",
                "text": "Farewell.",
                "nextNodeId": null,
                "conditions": [],
                "effects": []
              }
            ]
          },
          {
            "id": "road",
            "speaker": "",
            "text": "Mosslings gather on marked trails. The glowing gate leads to the moss grove. Speak to Elowen when you arrive.",
            "choices": [
              {
                "id": "understood",
                "text": "Thank you for the advice.",
                "nextNodeId": "welcome",
                "conditions": [],
                "effects": [
                  {
                    "flag": "road-advice",
                    "value": true
                  }
                ]
              },
              {
                "id": "leave",
                "text": "I should get going.",
                "nextNodeId": null,
                "conditions": [],
                "effects": []
              }
            ]
          },
          {
            "id": "offer",
            "speaker": "",
            "text": "Visit Elowen in the moss grove, clear a mossling encounter, and bring me her news. A kind word can open more paths than a sword.",
            "choices": [
              {
                "id": "accept",
                "text": "I will visit the grove.",
                "nextNodeId": "accepted",
                "conditions": [],
                "effects": [
                  {
                    "flag": "meet-keeper",
                    "value": true
                  }
                ]
              },
              {
                "id": "decline",
                "text": "Perhaps another time.",
                "nextNodeId": "welcome",
                "conditions": [],
                "effects": []
              }
            ]
          },
          {
            "id": "accepted",
            "speaker": "",
            "text": "Then go with care. I will be here when you return.",
            "choices": []
          },
          {
            "id": "thanks",
            "speaker": "",
            "text": "The grove welcomes you. Alderfell is brighter for your kindness.",
            "choices": [
              {
                "id": "finish",
                "text": "Until next time.",
                "nextNodeId": null,
                "conditions": [],
                "effects": [
                  {
                    "flag": "warden-thanks",
                    "value": true
                  }
                ]
              }
            ]
          }
        ]
      },
