                    "value": true
                  }
                ]
              },
              {
                "id": "return",
                "text": "It is good to see you again.",
                "nextNodeId": "blessed",
                "conditions": [
                  {
                    "flag": "grove-blessing",
                    "equals": true
                  }
                ],
                "effects": []
              },
              {
                "id": "leave",
                "text": "Farewell.",
                "nextNodeId": null,
                "conditions": [],
                "effects": []
              }
            ]
          },
          {
            "id": "blessed",
            "speaker": "",
            "text": "Carry the peace of this place with you. Tell Mara that the old paths are still watched over.",
            "choices": [
              {
                "id": "promise",
                "text": "I will bring Mara your news.",
                "nextNodeId": null,
                "conditions": [],
                "effects": []
              }
            ]
          }
        ]
      }
